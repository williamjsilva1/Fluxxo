rules_version = '2';
// Fluxxo — regras de segurança do Firestore
// Papéis: admin | editor | visualizador.  Status: pendente | ativo | bloqueado.
// O e-mail abaixo é sempre administrador (mesmo valor de ADMIN_BOOTSTRAP no index.html).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado()     { return request.auth != null; }
    function emailLower() { return request.auth.token.email.lower(); }
    function ehBoot()     { return logado() && emailLower() == 'williamjsilva1@gmail.com'; }
    function meuDoc()     { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function perfil()     { return get(meuDoc()).data; }
    function ativo()      { return ehBoot() || (logado() && exists(meuDoc()) && perfil().status == 'ativo'); }
    function admin()      { return ehBoot() || (ativo() && perfil().papel == 'admin'); }
    function editor()     { return admin() || (ativo() && perfil().papel == 'editor'); }
    function conviteDoc() { return /databases/$(database)/documents/convites/$(emailLower()); }

    // Aparência, nomes e menus (admin); índices de investimento (editor)
    match /config/{id} {
      allow read: if logado();
      allow write: if admin() || (id == 'indices' && editor());
    }

    // Usuários: cada um cria o próprio cadastro (pendente, ou ativo se houver convite)
    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow create: if logado() && request.auth.uid == uid && (
        ehBoot() ||
        (request.resource.data.status == 'pendente' && request.resource.data.papel == 'visualizador') ||
        (request.resource.data.status == 'ativo' && exists(conviteDoc()) &&
         get(conviteDoc()).data.papel == request.resource.data.papel)
      );
      allow update: if admin() || (logado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','online','ultimoAcesso']));
      allow delete: if admin();
    }

    // Convites por e-mail (id do documento = e-mail em minúsculas)
    match /convites/{email} {
      allow read: if admin() || (logado() && emailLower() == email);
      allow create, update: if admin();
      allow delete: if admin() || (logado() && emailLower() == email);
    }

    // Dados financeiros compartilhados
    match /{col}/{id} {
      allow read: if ativo() && col in ['contas','cartoes','categorias','lancamentos','orcamentos','metas','investimentos'];
      allow write: if editor() && col in ['contas','cartoes','categorias','lancamentos','orcamentos','metas','investimentos'];
    }
  }
}
